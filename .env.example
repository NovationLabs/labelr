# Ports exposed on the host machine
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Your public domain — added to Vite's allowedHosts
# Example: labelr.novationlabs.fr
ALLOWED_HOST=your-domain.com

# Keyboard layout for shortcuts: QWERTY or AZERTY
KEYBOARD_LAYOUT=QWERTY

# Shuffle label order randomly at startup and after each submit (True or False)
SHUFFLE=False

# Token required to access /export (leave empty to disable protection)
EXPORT_TOKEN=test12345

# Number of items per labeler chunk
CHUNK_SIZE=100

# List of labels (JSON array)
LABELS=["Question","Complaint","Suggestion","Praise","Bug Report","Feature Request","Urgent","Other"]
